# Copy to .env and fill in. Never commit .env.
# LLM for the cold path. Leave LLM_API_KEY empty to run fully offline (rules mode).
LLM_PROVIDER=gemini
LLM_API_KEY=
# Empty = auto-pick the newest available Gemini Flash-Lite model. Or set an exact model id from AI Studio.
LLM_MODEL=
# List prices in USD per 1M tokens, used only to report meta.cost_usd. Copy them from the provider's pricing page.
LLM_PRICE_IN_PER_1M=0.10
LLM_PRICE_OUT_PER_1M=0.40
LLM_TIMEOUT_S=7
# Gemini 3 thinking level (minimal keeps online latency low; the batch compile has its own --thinking flag)
LLM_THINKING=minimal
# Optional: model for eval/llm_judge.py (empty = strongest available Flash model)
LLM_JUDGE_MODEL=

# Optional tuning
CACHE_MIN_SIM=0.86
CACHE_MIN_SIM_SYMPTOM=0.82
CACHE_MIN_SIM_NO_SYMPTOM=0.88
DOC_MIN_RELEVANCE=0.69
CACHE_WRITE=1
